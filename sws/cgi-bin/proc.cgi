#!/bin/sh
echo "Content-Type: text/html"
echo ""
echo "<!DOCTYPE html>"
echo "<html lang='vi'><head><meta charset='UTF-8'><title>System Processes</title>"
echo "<style>body{font-family:'Segoe UI',sans-serif;background:#0f172a;color:#e2e8f0;padding:30px;}"
echo ".card{background:#1e293b;border-radius:10px;padding:25px;border:1px solid #334155;max-width:950px;margin:auto;}"
echo "h1{color:#c084fc;margin-top:0;} pre{background:#0b1120;padding:15px;border-radius:6px;color:#cbd5e1;font-family:Consolas,monospace;overflow-x:auto;}"
echo "a{color:#60a5fa;text-decoration:none;font-weight:bold;}</style></head><body>"
echo "<div class='card'>"
echo "<p><a href='/'>&larr; Quay lại Bảng điều khiển chính</a></p>"
echo "<h1>⚙️ Danh Sách Tiến Trình Hệ Thống Đang Chạy (Top Procs)</h1>"
echo "<hr style='border:0;border-top:1px solid #334155;'>"
echo "<pre>$(ps aux | head -n 25)</pre>"
echo "<hr style='border:0;border-top:1px solid #334155;'>"
echo "<p style='font-size:12px;color:#64748b;'>Xuất dữ liệu tiến trình trực tiếp từ hệ thống Linux /proc lúc $(date).</p>"
echo "</div></body></html>"
