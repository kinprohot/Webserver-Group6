#!/bin/sh
echo "Content-Type: text/html"
echo ""
echo "<!DOCTYPE html>"
echo "<html lang='vi'><head><meta charset='UTF-8'><title>Realtime System Info</title>"
echo "<style>body{font-family:'Segoe UI',sans-serif;background:#0f172a;color:#e2e8f0;padding:30px;}"
echo ".card{background:#1e293b;border-radius:10px;padding:25px;border:1px solid #334155;max-width:900px;margin:auto;box-shadow:0 4px 6px rgba(0,0,0,0.3);}"
echo "h1{color:#38bdf8;margin-top:0;} pre{background:#0b1120;padding:15px;border-radius:6px;color:#a5f3fc;font-family:Consolas,monospace;overflow-x:auto;}"
echo "a{color:#60a5fa;text-decoration:none;font-weight:bold;} a:hover{text-decoration:underline;}</style></head><body>"
echo "<div class='card'>"
echo "<p><a href='/'>&larr; Quay lại Bảng điều khiển chính</a></p>"
echo "<h1>📊 Thông Tin Phần Cứng & Tài Nguyên Máy Chủ (Real-time CGI)</h1>"
echo "<hr style='border:0;border-top:1px solid #334155;'>"
echo "<h3>1. Thông tin Nhân Hệ Điều Hành (Kernel & OS)</h3>"
echo "<pre>$(uname -a)</pre>"
echo "<h3>2. Trạng thái Bộ nhớ RAM (free -m)</h3>"
echo "<pre>$(free -h)</pre>"
echo "<h3>3. Thời gian hoạt động & Tải CPU (uptime)</h3>"
echo "<pre>$(uptime)</pre>"
echo "<h3>4. Dung lượng Phân vùng Ổ đĩa (df -h)</h3>"
echo "<pre>$(df -h /)</pre>"
echo "<hr style='border:0;border-top:1px solid #334155;'>"
echo "<p style='font-size:12px;color:#64748b;'>Truy vấn sinh tự động bởi CGI Engine (RFC 3875) trên SWS Server lúc $(date).</p>"
echo "</div></body></html>"
