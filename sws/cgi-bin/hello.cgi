#!/bin/sh
echo "Content-Type: text/html"
echo ""
echo "<!DOCTYPE html>"
echo "<html><head><title>CGI Execution Result</title>"
echo "<style>body{font-family:sans-serif;padding:30px;background:#f9f9f9;}</style>"
echo "</head><body>"
echo "<h1 style='color:#1f4e78;'>Common Gateway Interface (CGI) Response</h1>"
echo "<p>This dynamic content was generated by <strong>hello.cgi</strong> executed via <code>fork()</code> and <code>execl()</code>.</p>"
echo "<hr>"
echo "<h3>CGI Environment Variables (RFC3875):</h3>"
echo "<ul>"
echo "<li><strong>REQUEST_METHOD:</strong> $REQUEST_METHOD</li>"
echo "<li><strong>QUERY_STRING:</strong> $QUERY_STRING</li>"
echo "<li><strong>REMOTE_ADDR:</strong> $REMOTE_ADDR</li>"
echo "<li><strong>SERVER_PORT:</strong> $SERVER_PORT</li>"
echo "<li><strong>SERVER_SOFTWARE:</strong> $SERVER_SOFTWARE</li>"
echo "<li><strong>SCRIPT_NAME:</strong> $SCRIPT_NAME</li>"
echo "<li><strong>Current Server Timestamp:</strong> $(date)</li>"
echo "</ul>"
echo "<hr>"
echo "<p><em>Team members: Nguyen Hoang Luc (23IT151), Nguyen Xuan Lam, Nguyen Dang Luan, Vo Thi Quynh Linh</em></p>"
echo "</body></html>"
